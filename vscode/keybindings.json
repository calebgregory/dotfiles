// Place your key bindings in this file to override the defaultsauto[]
[
  {
    "key": "f12",
    "command": "editor.action.openLink",
    "when": "editorTextFocus && editorLangId == 'markdown'"
  },
  {
    "key": "cmd+y",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+b",
    "command": "-workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "cmd+t cmd+t",
    "command": "workbench.view.extension.todomd"
  },
  {
    "key": "ctrl+shift+0",
    "command": "github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated"
  },
  {
    "key": "ctrl+enter",
    "command": "-github.copilot.generate",
    "when": "editorTextFocus && github.copilot.activated"
  },
  {
    "key": "ctrl+\\",
    "command": "editor.action.inlineSuggest.trigger",
    "when": "config.github.copilot.inlineSuggest.enable && editorTextFocus && !editorHasSelection && !inlineSuggestionsVisible"
  },
  {
    "key": "alt+\\",
    "command": "-editor.action.inlineSuggest.trigger",
    "when": "config.github.copilot.inlineSuggest.enable && editorTextFocus && !editorHasSelection && !inlineSuggestionsVisible"
  },
  {
    "key": "alt+\\ alt+\\",
    "command": "github.copilot.toggleCopilot"
  },
  {
    "key": "cmd+g cmd+c",
    "command": "issue.copyGithubPermalink"
  },
  {
    "key": "cmd+e cmd+m",
    "command": "workbench.files.action.collapseExplorerFolders"
  },
  {
    "key": "cmd+g cmd+h",
    "command": "issues:github.focus"
  },
  {
    "key": "cmd+r cmd+q",
    "command": "sqlite.runDocumentQuery",
    "when": "editorLangId =~ /(sql|sqlite)/"
  },
  {
    "key": "shift+cmd+q",
    "command": "-sqlite.runDocumentQuery",
    "when": "editorLangId =~ /(sql|sqlite)/"
  },
  {
    "key": "cmd+r cmd+w",
    "command": "sqlite.runSelectedQuery"
  },
  {
    "key": "cmd+k ;",
    "command": "copyRelativeFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "shift+alt+cmd+c",
    "command": "-copyRelativeFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "shift+cmd+c",
    "command": "-workbench.action.terminal.openNativeConsole",
    "when": "!terminalFocus"
  },
  {
    "key": "alt+cmd+c",
    "command": "-copyFilePath",
    "when": "!editorFocus"
  },
  {
    "key": "cmd+k alt+cmd+c",
    "command": "-copyFilePath",
    "when": "editorFocus"
  },
  {
    "key": "cmd+k ;",
    "command": "copyRelativeFilePath",
    "when": "editorFocus"
  },
  {
    "key": "cmd+k shift+alt+cmd+c",
    "command": "-copyRelativeFilePath",
    "when": "editorFocus"
},
{
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
        "text": "\u001b\r"
    },
    "when": "terminalFocus"
},
{
  "key": "alt+cmd+c",
  "command": "-search.action.copyPath",
  "when": "fileMatchOrFolderMatchWithResourceFocus"
},
{
  "key": "ctrl+w shift+l",
  "command": "workbench.action.positionPanelRight"
},
{
  "key": "ctrl+w shift+h",
  "command": "workbench.action.positionPanelLeft"
},
{
  "key": "ctrl+w shift+j",
  "command": "workbench.action.positionPanelBottom"
},
{
  "key": "ctrl+w shift+k",
  "command": "workbench.action.positionPanelTop"
},
{
  "key": "ctrl+w shift+t",
  "command": "workbench.action.terminal.moveToTerminalPanel"
},
{
  "key": "ctrl+w f",
  "command": "workbench.action.focusPanel"
},
{
  "key": "ctrl+w k",
  "command": "workbench.action.focusAboveGroup"
},
{
  "key": "cmd+k cmd+up",
  "command": "-workbench.action.focusAboveGroup"
},
{
  "key": "ctrl+w j",
  "command": "workbench.action.focusBelowGroup"
},
{
  "key": "cmd+k cmd+down",
  "command": "-workbench.action.focusBelowGroup"
},
{
  "key": "ctrl+w h",
  "command": "workbench.action.focusLeftGroup"
},
{
  "key": "cmd+k cmd+left",
  "command": "-workbench.action.focusLeftGroup"
},
{
  "key": "ctrl+w l",
  "command": "workbench.action.focusRightGroup"
},
{
  "key": "cmd+k cmd+right",
  "command": "-workbench.action.focusRightGroup"
},
{
  "key": "ctrl+w t",
  "command": "terminal.focus"
},
{
  "key": "ctrl+w .",
  "command": "workbench.action.focusActiveEditorGroup"
}
]